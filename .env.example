STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/auth/callback
DATABASE_PATH=./strava.db
EXPORT_DIR=./exports
# Used only when activities.csv is the sole source for an activity.
# Strava exports are normally metric. Set to mi only if your CSV is in miles.
STRAVA_EXPORT_DISTANCE_UNIT=km

# Optional AI coach. With "none", or with no Gemini key, deterministic
# beginner-safe analysis is used and no data leaves this computer.
AI_PROVIDER=none
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash
AI_FALLBACK_MODEL=gemini-2.5-flash
# Optional plain-language context sent in the privacy-filtered payload.
AI_USER_CONTEXT=Beginner run/walk runner; prioritize consistency and injury prevention.
PREFERRED_SESSIONS_PER_WEEK=2
TRAINING_GOAL=continuous_5k

# Optional heart-rate configuration. Leave blank to keep HR-zone output null.
MAX_HR=
# Five comma-separated upper bounds, e.g. 120,140,155,170,190.
HR_ZONE_BOUNDS=

# Beginner-friendly, conservative analysis thresholds (optional overrides).
WALK_SPEED_THRESHOLD_MPS=1.8
MIN_WALK_BREAK_SEC=15
LONG_RUN_WEEKLY_PERCENTILE=0.8
FAST_PACE_IMPROVEMENT_PERCENT=10
SUDDEN_VOLUME_RATIO=1.3
SUDDEN_VOLUME_MIN_INCREASE_KM=5
MAX_HARD_SESSIONS_7D=2
